# =============================================================================
# NCP — environment template (copy to `.env` / `.env.local`; never commit secrets)
# =============================================================================

# --- Next.js (frontend) ---
# Public URL of the Strapi API (browser + server)
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
# Server-only Strapi URL if different from public (optional)
STRAPI_URL=http://localhost:1337
# Strapi API token for server-side reads (create in Strapi Admin → Settings → API Tokens)
STRAPI_API_TOKEN=
# Optional: force no-op ContentPort (tests / CMS offline). Default binds Strapi adapter.
# CONTENT_ADAPTER=noop
# Optional: force no-op DirectoryPort (tests / CMS offline). Default binds Strapi adapter.
# DIRECTORY_ADAPTER=noop
# Note: DirectoryPort.suggestListing requires STRAPI_API_TOKEN with Listing create permission.
# Password reset (MailPort path) needs the same token — Strapi validates it on POST /api/password-reset/issue.
# Optional: force no-op AuthPort + MemberPort (tests / CMS offline). Default binds Strapi + httpOnly cookie session.
# AUTH_ADAPTER=noop
# Optional: force no-op SearchPort (tests / CMS offline). Default binds Strapi filter adapter.
# SEARCH_ADAPTER=noop

# App / site
# Local default. Production: https://your-agreed-domain (NH-1) — no trailing slash.
# Used for sitemap/robots, metadataBase, Stripe return URLs, password-reset links.
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# --- Production go-live ---
# Checklist: docs/production-go-live.md · Compose Option B: deploy/
# Validate required vars (prints names only): node scripts/check-production-env.mjs
# DATABASE_* is consumed by Strapi only (cms/.env) — not by Next port code.
# --- Strapi (CMS) — set in `cms/.env` (see cms/.env.example) ---
# Hosted API base used by Next (same as NEXT_PUBLIC_STRAPI_URL in local monorepo)
# STRAPI_HOST=0.0.0.0
# STRAPI_PORT=1337

# --- Database (generic; consumed by Strapi config, NOT by Next app code) ---
# Default concrete engine for first deploy: PostgreSQL.
# Swap to mysql later via DATABASE_CLIENT + credentials only — no app rewrite.
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5434
DATABASE_NAME=ncp_strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=
DATABASE_SSL=false
# Optional connection URL (if your host provides one; prefer discrete vars when possible)
# DATABASE_URL=

# --- Payments (Sprint 6; Stripe behind PaymentPort) ---
# Test keys first (sk_test_… / pk_test_…). Live smoke = NH-3 on NCP Stripe account only
# (never a developer account). Procedure: docs/stripe-live-smoke.md
# Live: STRIPE_SECRET_KEY=sk_live_… (+ pk_live_… when client publishable key is needed).
# Optional: force no-op PaymentPort (tests). Default binds Stripe / bank-config from env.
# PAYMENT_ADAPTER=noop
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Public bank details for donate page (NH-4). Omit any → getBankTransferDetails returns null.
# BANK_ACCOUNT_NAME=
# BANK_SORT_CODE=
# BANK_ACCOUNT_NUMBER=
# BANK_NAME=
# Charity identity for Gift Aid + donate copy (NH-2). Both required → getCharityIdentity returns value.
# CHARITY_REGISTERED_NAME=Nigerian Community Peterborough
# CHARITY_NUMBER=
# Optional official Gift Aid declaration (NH-5). Omit → HMRC-aligned default using registered name.
# GIFT_AID_DECLARATION=

# --- Mail (Sprint 5; transactional via MailPort) ---
# Required for real sends (NH-6). Without MAIL_FROM, MailPort stays noop.
# MAIL_FROM=noreply@your-ncp-domain.co.uk
# MAIL_PROVIDER=console   # logs only (local smoke)
# MAIL_PROVIDER=resend    # Resend HTTP; also set RESEND_API_KEY
# RESEND_API_KEY=
