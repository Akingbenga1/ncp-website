# =============================================================================
# NCP — environment template (copy to `.env` / `.env.local`; never commit secrets)
# =============================================================================

# --- Next.js (frontend) ---
# Public URL of the Strapi API (browser + server)
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
# Server-only Strapi URL if different from public (optional)
STRAPI_URL=http://localhost:1337
# Strapi API token for server-side reads (create in Strapi Admin → Settings → API Tokens)
STRAPI_API_TOKEN=

# App / site
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# --- Strapi (CMS) — set in `cms/.env` (see cms/.env.example) ---
# Hosted API base used by Next (same as NEXT_PUBLIC_STRAPI_URL in local monorepo)
# STRAPI_HOST=0.0.0.0
# STRAPI_PORT=1337

# --- Database (generic; consumed by Strapi config, NOT by Next app code) ---
# Default concrete engine for first deploy: PostgreSQL.
# Swap to mysql later via DATABASE_CLIENT + credentials only — no app rewrite.
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5434
DATABASE_NAME=ncp_strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=
DATABASE_SSL=false
# Optional connection URL (if your host provides one; prefer discrete vars when possible)
# DATABASE_URL=

# --- Payments (Sprint 6; placeholders only) ---
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Mail (Sprint 5; placeholders only) ---
# MAIL_FROM=
# MAIL_PROVIDER=
