# Production secrets for deploy/docker-compose.prod.yml — copy to .env.prod (never commit)

# --- Public origins (HTTPS after reverse proxy) ---
NEXT_PUBLIC_SITE_URL=https://www.example.co.uk
NEXT_PUBLIC_STRAPI_URL=https://cms.example.co.uk
PUBLIC_URL=https://cms.example.co.uk

# --- Postgres ---
DATABASE_CLIENT=postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=ncp_strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=change-me-strong
DATABASE_SSL=false
POSTGRES_PASSWORD=change-me-strong

# --- Strapi secrets (generate unique values) ---
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=change-me
ADMIN_JWT_SECRET=change-me
TRANSFER_TOKEN_SALT=change-me
JWT_SECRET=change-me
ENCRYPTION_KEY=change-me

# --- Next server ---
STRAPI_API_TOKEN=
