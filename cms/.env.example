# Server
HOST=0.0.0.0
PORT=1337

# Secrets — replace before any shared/staging/production use (never commit real values)
APP_KEYS=toBeModified1,toBeModified2,toBeModified3,toBeModified4
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database — default concrete engine: PostgreSQL (MySQL swap via DATABASE_CLIENT only)
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5434
DATABASE_NAME=ncp_strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=
DATABASE_SSL=false
# DATABASE_URL=
# DATABASE_FILENAME=

# Public URL of this Strapi instance (used by Next as NEXT_PUBLIC_STRAPI_URL)
# http://localhost:1337
